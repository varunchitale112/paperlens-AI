{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "TSX_RUN=true tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --bundle --external:vite --external:express --external:pdf-parse --external:multer --external:@google/genai --outfile=dist/server.cjs",
